# 模型网关配置模板
#
# 复制成 secrity.env（已被 .gitignore 的 *.env 覆盖），填入真实值。
# 不要在仓库里提交任何真实密钥。

# 中转站地址（不带 /v1）
BASE_URL=https://api.example.com

# 密钥
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 默认视频模型（MODEL_NAME 是旧名，新配置用 VIDEO_MODEL）
VIDEO_MODEL=minimax-h3
# MODEL_NAME=minimax-h3

# 可选：文本 / 配音 / 识别模型
TEXT_MODEL=deepseek-v4.1-flash-1017
TTS_MODEL=seedance-2.0
# ASR_MODEL=qwen-audio-3.0-asr-flash

# 视频接口路由族：treecloud（POST /v1/videos/generations）或 litellm（POST /v1/videos）
# 不填按 treecloud；遇到 404/405 会自动换另一条
# VIDEO_API=treecloud

# 图片模型（默认 gpt-image-2-c，按张计价 ¥0.12）
IMAGE_MODEL=gpt-image-2-c

# 可选：默认分辨率 / 图片尺寸
# VIDEO_RESOLUTION=768p
# IMAGE_SIZE=1024x1536

# 成片渲染允许下载的远端素材域名（逗号分隔，支持 host:port / *.example.com）
# 不填则一个远端素材都不下载，片段退回清单里的兜底图（ADR-0092）
# RENDER_ALLOWED_HOSTS=cdn.example.com,oss.example.com
